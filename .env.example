# ==========================================
# BharatYatra Environment Configuration
# ==========================================

# Database
# Local SQLite for immediate development:
DATABASE_URL="file:./dev.db"
# Production PostgreSQL (Neon, Supabase, AWS RDS, Docker):
# DATABASE_URL="postgresql://bharat_admin:secret@localhost:5432/bharatyatra?schema=public"

# Backend API
PORT=4000
NODE_ENV=development
API_BASE_URL="http://localhost:4000"
CORS_ORIGIN="http://localhost:3000,http://localhost:8081,http://localhost:19006"

# Security & JWT
JWT_SECRET="bharat-yatra-ultra-secure-jwt-secret-key-2026"
JWT_REFRESH_SECRET="bharat-yatra-refresh-secret-token-key-2026"
JWT_EXPIRES_IN="7d"

# Payment Gateway (Razorpay India)
RAZORPAY_KEY_ID="rzp_test_BharatYatraKey123"
RAZORPAY_KEY_SECRET="rzp_test_BharatYatraSecretKey456"
PAYMENT_PROVIDER_MODE="demo" # 'demo' | 'live'

# Maps & Weather Providers
MAPS_PROVIDER="leaflet_osm" # 'leaflet_osm' | 'google_maps' | 'mapbox'
MAPS_API_KEY="demo_key"
WEATHER_API_KEY="demo_key"

# AI Engine
AI_PROVIDER="internal_engine" # 'internal_engine' | 'gemini' | 'openai'
AI_API_KEY="demo_ai_key"
